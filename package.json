{
  "name": "scratch-vm",
  "version": "2.1.46",
  "packageManager": "pnpm@10.33.0",
  "description": "Virtual Machine for Scratch 3.0",
  "author": "Massachusetts Institute of Technology",
  "license": "MPL-2.0",
  "homepage": "https://github.com/scratchfoundation/scratch-vm#readme",
  "repository": {
    "type": "git",
    "url": "https://github.com/scratchfoundation/scratch-vm.git"
  },
  "main": "./src/index.js",
  "browser": "./src/index.js",
  "scripts": {
    "build": "rspack build",
    "coverage": "tap ./test/{unit,integration}/*.js --coverage --coverage-report=lcov",
    "docs": "jsdoc -c .jsdoc.json",
    "i18n:src": "mkdirp translations/core && format-message extract --out-file translations/core/en.json src/extensions/**/index.js",
    "i18n:push": "tx-push-src scratch-editor extensions translations/core/en.json",
    "lint": "eslint .",
    "prepublish": "in-publish && pnpm run build || not-in-publish",
    "start": "rspack serve",
    "tap": "tap ./test/{unit,integration}/*.js",
    "tap:unit": "tap ./test/unit/*.js",
    "tap:integration": "tap ./test/integration/*.js",
    "test": "pnpm run lint && pnpm run tap",
    "watch": "rspack build --watch",
    "version": "json -f package.json -I -e \"this.repository.sha = '$(git log -n1 --pretty=format:%H)'\""
  },
  "tap": {
    "branches": 60,
    "functions": 70,
    "lines": 70,
    "statements": 70
  },
  "dependencies": {
    "@turbowarp/json": "^0.1.2",
    "@turbowarp/jszip": "^3.11.0",
    "@turbowarp/nanolog": "^0.2.0",
    "@vernier/godirect": "1.5.0",
    "decode-html": "2.0.0",
    "diff-match-patch": "1.0.4",
    "buffer": "6.0.3",
    "events": "3.3.0",
    "format-message": "6.2.1",
    "htmlparser2": "3.10.0",
    "scratch-parser": "github:Nitro-Bolt/scratch-parser#master",
    "scratch-sb1-converter": "0.2.7",
    "scratch-translate-extension-languages": "^1.0.7",
    "url": "0.11.4",
    "uuid": "11.1.1"
  },
  "peerDependencies": {
    "@turbowarp/scratch-svg-renderer": "^1.1.0"
  },
  "devDependencies": {
    "@rspack/cli": "2.2.9",
    "@rspack/core": "2.2.9",
    "@rspack/dev-server": "2.2.1",
    "@babel/eslint-parser": "7.28.5",
    "adm-zip": "0.4.11",
    "callsite": "1.0.0",
    "docdash": "1.2.0",
    "eslint": "8.55.0",
    "eslint-config-scratch": "9.0.3",
    "format-message-cli": "6.2.0",
    "in-publish": "2.0.1",
    "js-md5": "0.7.3",
    "jsdoc": "3.6.6",
    "json": "^9.0.4",
    "pngjs": "3.3.3",
    "scratch-audio": "0.1.0-prerelease.20231221012053",
    "scratch-l10n": "3.16.20231222031921",
    "scratch-render": "0.1.0-prerelease.20231220210403",
    "scratch-render-fonts": "github:TurboWarp/scratch-render-fonts#master",
    "@turbowarp/scratch-svg-renderer": "^1.1.0",
    "scratch-storage": "2.3.1",
    "stats.js": "0.17.0",
    "tap": "16.2.0",
    "tiny-worker": "2.3.0"
  },
  "private": true,
  "pnpm": {
    "onlyBuiltDependencies": [
      "core-js",
      "es5-ext"
    ]
  }
}
